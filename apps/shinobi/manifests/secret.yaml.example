---
apiVersion: v1
kind: Secret
metadata:
  name: shinobi-secrets
  namespace: shinobi
type: Opaque
stringData:
  # Shinobi Plugin Keys
  # Get your plugin keys from: https://shinobi.video/plugins
  plugin-keys: '{"Motion":"YOUR-MOTION-PLUGIN-KEY-HERE"}'

  # Optional: Database credentials if using external DB
  # db-user: "shinobi"
  # db-password: "your-secure-password"

  # Optional: SMTP credentials for email notifications
  # smtp-user: "your-email@example.com"
  # smtp-password: "your-email-password"

# IMPORTANT: Copy this file to secret.yaml and replace with your actual values
# DO NOT commit secret.yaml to git - it should be in .gitignore
